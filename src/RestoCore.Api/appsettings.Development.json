{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=restocore_dev;Username=postgres;Password=postgres_dev_password;Pooling=true;Maximum Pool Size=100;Minimum Pool Size=10"
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
