    "BucketName": "restocore-images",
    "AccessKey": "any",
    "SecretKey": "any"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "RestoCore.Backend"
  }
